token Query='query' Fragment='fragment' Filter='filter' Condition='condition' On='on' Apply='apply' When='when' Field='field' Where='where' Order='order' By='by' Limit='limit' Offset='offset' Asc='asc' Desc='desc' True='true' False='false' Null='null' Like='like' And='and' Or='or' Not='not' In='in' Is='is' Exists='exists';
token LBrace='{' RBrace='}' LPar='(' RPar=')' LBracket='[' RBracket=']' ColonColon='::' Arrow='->' Colon=':' At='@' Comma=',' Pipe='|' Ellipsis='...' DotDot='..' Dot='.' Tilde='~' DollarDollar='$$' Dollar='$';
token Eq='==' Ne='!=' Gt='>' Ge='>=' Lt='<' Le='<=';
token Name='<name>' String='<string>' Number='<number>';
token Whitespace Comment;

skip Whitespace Comment;

start document;

document: definition*;
contextual_name: 'not' | 'in' | 'is' | 'exists' | 'filter' | 'condition' | 'apply' | 'when' | 'field';
definition^:
  query_def
| fragment_def
| filter_def
| condition_def
;
query_def: 'query' (Name | contextual_name) [query_filter_header] directive* selection_set;
fragment_def: 'fragment' (Name | contextual_name) 'on' qualified_name selection_set;
filter_def: 'filter' (Name | contextual_name) ['on' policy_target] filter_body;
condition_def: 'condition' (Name | contextual_name) ['on' policy_target] condition_body;
policy_target: qualified_name | shape_target;
shape_target: '{' shape_field* '}';
shape_field: '.' (Name | contextual_name) ':' (Name | contextual_name) [','];
filter_body: '{' filter_rule* '}';
filter_rule: apply_rule | where_clause | field_rule;
condition_body: '{' where_clause '}';
apply_rule: 'apply' [?1 'where' expr];
field_rule: 'field' (Name | contextual_name) (?1 ',' (Name | contextual_name))* 'where' expr;
query_filter_header: '(' filter_assignment+ ')';
filter_assignment: 'filter' (Name | contextual_name) ['when' expr];
qualified_name: (Name | contextual_name) [?1 '::' (Name | contextual_name)];
relation_ref: qualified_name ['->' (Name | contextual_name)];
scoped_path_segment: qualified_name ['->' (Name | contextual_name)];
scoped_path: ('.' | '..' | '~') scoped_path_segment ('.' scoped_path_segment)*;
value_variable: '$$' [Name] | '$' (':' Name / [Name]);
comparison_operator: '==' | '!=' | '>' | '>=' | '<' | '<=' | 'like';
operator_variable: ('$' | '$$') [Name] '[' comparison_operator (?1 ',' comparison_operator)* [','] ']';
binary_operator: comparison_operator | operator_variable;
selection_set: '{' selection* '}';
selection:
  ?1 field_selection [',']
| fragment_spread [',']
;
fragment_spread: '...' (Name | contextual_name) directive*;
field_selection: ['...'] relation_ref field_selection_tail;
field_selection_tail:
  ':' relation_ref field_suffix
| field_suffix
;
field_suffix: [clause_list] (pipe_transform | directive* [selection_set]);
pipe_transform: '|' (Name | contextual_name) ['by' aggregate_group_key (?1 ',' aggregate_group_key)* [',']] aggregate_set;
aggregate_group_key: [(Name | contextual_name) ':'] scoped_path;
aggregate_set: '{' aggregate_field* '}';
aggregate_field:
  Name [?1 ':' (Name / contextual_name)] [scoped_path] [',']
| contextual_name [?1 ':' (Name / contextual_name)] [scoped_path] [','];
clause_list: '(' clause* ')';
clause:
  filter_assignment
| where_clause
| order_by_clause
| limit_clause
| offset_clause
;
where_clause: 'where' expr;
order_by_clause: 'order' 'by' order_item (?1 ',' order_item)* [','];
sort_direction: 'asc' | 'desc' | value_variable;
order_item: qualified_name [sort_direction];
limit_clause: 'limit' expr;
offset_clause: 'offset' expr;
directive: '@' directive_name [?1 '(' directive_argument (?2 ',' directive_argument)* [','] ')'];
directive_name:
  '.' directive_member
| directive_namespace ['.' directive_member]
;
directive_namespace: Name | contextual_name;
directive_member: Name | contextual_name;
directive_argument: (Name | contextual_name) ':' expr;
scalar_aggregate_expr: scoped_path '|' (Name | contextual_name) [scoped_path];
collection_literal: '[' [expr (?1 ',' expr)* [',']] ']';
exists_source: (scoped_path | qualified_name) ['(' filter_assignment* [where_clause] ')'];
exists_expr: 'exists' exists_source;
expr:
  expr (binary_operator | 'in' | 'not' 'in') expr @binary_expr
| expr 'is' ('not' 'null' / 'null') @null_test_expr
| ?2 'not' expr @unary_expr
| expr 'and' expr @binary_expr
| expr 'or' expr @binary_expr
| literal
| collection_literal
| ?1 exists_expr
| predicate_name
| ?3 scalar_aggregate_expr
| scoped_path
| value_variable
| '(' expr ')'
;
predicate_name: Name;
literal:
  String
| Number
| 'true'
| 'false'
| 'null'
;
