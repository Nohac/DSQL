-- NestedOptionalPredicates
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'id',
        "users_99fc7350"."id",
        'posts',
        "posts_json_9b3bd304"."posts_result_9b3bd304"
      )
    ),
    '[]'
  ) as "users"
from
  (
    select
      *
    from
      "public"."users" as "users_99fc7350"
    where
      (
        (
          (
            ("users_99fc7350"."name" like $1)
            and ($1 is not null)
          )
          or (
            (
              not (
                (
                  "users_99fc7350"."id" >= ($2)
                  or (not ($2 is not null))
                )
                and (
                  "users_99fc7350"."id" <= ($3)
                  or (not ($3 is not null))
                )
              )
            )
            and (
              ($2 is not null)
              or ($3 is not null)
            )
          )
          or (
            not (
              ($1 is not null)
              or (
                ($2 is not null)
                or ($3 is not null)
              )
            )
          )
        )
        and (
          (
            exists (
              select
                1
              from
                "public"."posts" as "posts_fa21ec3d"
              where
                "posts_fa21ec3d"."user_id" = "users_99fc7350"."id"
                and (
                  ("posts_fa21ec3d"."title" like $4)
                  or (not ($4 is not null))
                )
            )
            and ($4 is not null)
          )
          or (
            exists (
              select
                1
              from
                "public"."posts" as "posts_fa21ec3d"
              where
                "posts_fa21ec3d"."user_id" = "users_99fc7350"."id"
                and exists (
                  select
                    1
                  from
                    "public"."users" as "users_896e6dda"
                  where
                    "users_896e6dda"."id" = "posts_fa21ec3d"."user_id"
                    and (
                      ("users_896e6dda"."name" like $5)
                      or (not ($5 is not null))
                    )
                )
            )
            and ($5 is not null)
          )
          or (
            not (
              ($4 is not null)
              or ($5 is not null)
            )
          )
        )
      )
      or (
        not (
          ($1 is not null)
          or (
            ($2 is not null)
            or ($3 is not null)
          )
          or (
            ($4 is not null)
            or ($5 is not null)
          )
        )
      )
    limit
      10
  ) as "users_99fc7350"
  left join LATERAL (
    select
      COALESCE(
        JSON_AGG(
          JSON_BUILD_OBJECT(
            'id',
            "posts_9b3bd304"."id",
            'title',
            "posts_9b3bd304"."title"
          )
        ),
        '[]'
      ) as "posts_result_9b3bd304"
    from
      (
        select
          *
        from
          "public"."posts" as "posts_9b3bd304"
        where
          "posts_9b3bd304"."user_id" = "users_99fc7350"."id"
          and (
            (
              (
                ("posts_9b3bd304"."title" like $4)
                or (not ($4 is not null))
              )
              and (
                exists (
                  select
                    1
                  from
                    "public"."users" as "users_896e6dda"
                  where
                    "users_896e6dda"."id" = "posts_9b3bd304"."user_id"
                    and (
                      ("users_896e6dda"."name" like $5)
                      or (not ($5 is not null))
                    )
                )
                or (not ($5 is not null))
              )
              and (
                ($4 is not null)
                or ($5 is not null)
              )
            )
            or (
              (
                not (
                  (
                    exists (
                      select
                        1
                      from
                        "public"."users" as "users_896e6dda"
                      where
                        "users_896e6dda"."id" = "posts_9b3bd304"."user_id"
                        and (
                          "users_896e6dda"."id" >= ($2)
                          or (not ($2 is not null))
                        )
                    )
                    or (not ($2 is not null))
                  )
                  and (
                    exists (
                      select
                        1
                      from
                        "public"."users" as "users_896e6dda"
                      where
                        "users_896e6dda"."id" = "posts_9b3bd304"."user_id"
                        and (
                          "users_896e6dda"."id" <= ($3)
                          or (not ($3 is not null))
                        )
                    )
                    or (not ($3 is not null))
                  )
                )
              )
              and (
                ($2 is not null)
                or ($3 is not null)
              )
            )
            or (
              not (
                ($4 is not null)
                or ($5 is not null)
                or (
                  ($2 is not null)
                  or ($3 is not null)
                )
              )
            )
          )
        limit
          10
      ) as "posts_9b3bd304"
  ) as "posts_json_9b3bd304" on true
