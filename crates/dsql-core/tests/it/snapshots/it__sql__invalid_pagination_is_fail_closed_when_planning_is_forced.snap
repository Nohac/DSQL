---
source: crates/dsql-core/tests/it/sql.rs
expression: render_sql(&bowl).await
---
-- InvalidLimitBeforeOffset
select
  COALESCE(
    JSON_AGG(JSON_BUILD_OBJECT('id', "users_99fc7350"."id")),
    '[]'
  ) as "users"
from
  (
    select
      *
    from
      "public"."users" as "users_99fc7350"
    limit
      0
  ) as "users_99fc7350"

-- NestedIsolation
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'posts',
        "posts_json_9b3bd304"."posts_result_9b3bd304"
      )
    ),
    '[]'
  ) as "users"
from
  (
    select
      *
    from
      "public"."users" as "users_99fc7350"
    limit
      5
  ) as "users_99fc7350"
  left join LATERAL (
    select
      COALESCE(
        JSON_AGG(JSON_BUILD_OBJECT('id', "posts_9b3bd304"."id")),
        '[]'
      ) as "posts_result_9b3bd304"
    from
      (
        select
          *
        from
          "public"."posts" as "posts_9b3bd304"
        where
          "posts_9b3bd304"."user_id" = "users_99fc7350"."id"
        limit
          0
      ) as "posts_9b3bd304"
  ) as "posts_json_9b3bd304" on true

-- OffsetBeforeInvalidLimit
select
  COALESCE(
    JSON_AGG(JSON_BUILD_OBJECT('id', "users_99fc7350"."id")),
    '[]'
  ) as "users"
from
  (
    select
      *
    from
      "public"."users" as "users_99fc7350"
    limit
      0
  ) as "users_99fc7350"

-- ValidBoundaries
select
  "root_0"."zero" as "zero",
  "root_1"."maximum" as "maximum"
from
  (
    select
      COALESCE(
        JSON_AGG(JSON_BUILD_OBJECT('id', "zero_c9fc37c2"."id")),
        '[]'
      ) as "zero"
    from
      (
        select
          *
        from
          "public"."users" as "zero_c9fc37c2"
        limit
          0
      ) as "zero_c9fc37c2"
  ) as "root_0"
  cross join (
    select
      COALESCE(
        JSON_AGG(JSON_BUILD_OBJECT('id', "maximum_a157958e"."id")),
        '[]'
      ) as "maximum"
    from
      (
        select
          *
        from
          "public"."users" as "maximum_a157958e"
        limit
          10 offset 9223372036854775807
      ) as "maximum_a157958e"
  ) as "root_1"

-- ValidLimitBeforeInvalidOffset
select
  COALESCE(
    JSON_AGG(JSON_BUILD_OBJECT('id', "users_99fc7350"."id")),
    '[]'
  ) as "users"
from
  (
    select
      *
    from
      "public"."users" as "users_99fc7350"
    limit
      0
  ) as "users_99fc7350"
