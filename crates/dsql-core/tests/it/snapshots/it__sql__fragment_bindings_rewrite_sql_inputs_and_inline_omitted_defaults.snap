        where
          "posts_9b3bd304"."user_id" = "users_99fc7350"."id"
          and "posts_9b3bd304"."title" >= ($1)
        limit
          LEAST(COALESCE($2, 10), 10)
      ) as "posts_9b3bd304"
  ) as "posts_json_9b3bd304" on true
-- parameters: input.users.body.PostWindow.params.minimum, input.users.body.PostWindow.params.limit

