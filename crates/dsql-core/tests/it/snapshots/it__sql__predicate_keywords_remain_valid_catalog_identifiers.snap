---
source: crates/dsql-core/tests/it/sql.rs
expression: render_sql(&bowl).await
---
-- exists
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'exists',
        CAST("metrics_b773e828"."exists" as text),
        'in',
        CAST("metrics_b773e828"."exists" as text),
        'is',
        CAST("metrics_b773e828"."is" as text),
        'not',
        CAST("metrics_b773e828"."not" as text)
      )
      order by
        "metrics_b773e828"."exists" asc
    ),
    '[]'
  ) as "metrics"
from
  (
    select
      *
    from
      "public"."metrics" as "metrics_b773e828"
    where
      "metrics_b773e828"."exists" = 1
      and "metrics_b773e828"."in" = 2
      and "metrics_b773e828"."is" = 3
      and "metrics_b773e828"."not" = 4
    order by
      "metrics_b773e828"."exists" asc
    limit
      10
  ) as "metrics_b773e828"
