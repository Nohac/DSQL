---
source: crates/dsql-core/tests/it/sql.rs
expression: "format!(\"before:\\n{before}\\n\\nafter:\\n{after}\")"
---
before:
-- title
select
  "dsql_root"."title" as "title"
from
  (
    select
      1) as "dsql_singleton"
  left join LATERAL (
    select
      JSON_BUILD_OBJECT('id', "title_d4d9f554"."id") as "title"
    from
      "public"."title" as "title_d4d9f554"
    where
      "title_d4d9f554"."id" > 0
    limit
      1
  ) as "dsql_root" on true

after:
-- title
select
  "dsql_root"."title" as "title"
from
  (
    select
      1) as "dsql_singleton"
  left join LATERAL (
    select
      JSON_BUILD_OBJECT('id', "title_d4d9f554"."id") as "title"
    from
      "public"."title" as "title_d4d9f554"
    where
      "title_d4d9f554"."id" > 1
    limit
      1
  ) as "dsql_root" on true
