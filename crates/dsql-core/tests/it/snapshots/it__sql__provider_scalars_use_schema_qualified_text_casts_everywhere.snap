-- ProviderScalars
select
  "root"."events" as "events"
from
  (
    select
      1) as "singleton"
  left join LATERAL (
    select
      JSON_BUILD_OBJECT(
        'event_date',
        CAST("events_cc4ff0da"."event_date" as text),
        'local_time',
        CAST("events_cc4ff0da"."local_time" as text),
        'address',
        CAST("events_cc4ff0da"."address" as text),
        'big_id',
        CAST("events_cc4ff0da"."big_id" as text)
      ) as "events"
    from
      "public"."events" as "events_cc4ff0da"
    where
      "events_cc4ff0da"."address" = ((($1)::text)::"pg_catalog"."inet")
      and (
        "events_cc4ff0da"."event_date" = ((($2)::text)::"pg_catalog"."date")
        and "events_cc4ff0da"."local_time" >= ((($3)::text)::"pg_catalog"."timestamp")
        and (
          "events_cc4ff0da"."address" = ANY((($4)::text[])::"pg_catalog"."inet"[])
        )
        and "events_cc4ff0da"."big_id" >= ($5)
        and "events_cc4ff0da"."big_id" <= 9223372036854775807
        and ({{dynamic:0}})
      )
    order by
      "events_cc4ff0da"."local_time" asc
    limit
      1
  ) as "root" on true
-- parameters: context.trusted_address, params.date, params.start, params.addresses, params.minimum_big_id

