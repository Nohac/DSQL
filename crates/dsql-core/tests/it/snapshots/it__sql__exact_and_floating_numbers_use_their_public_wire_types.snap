---
source: crates/dsql-core/tests/it/sql.rs
expression: render_sql(&bowl).await
---
-- groups
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'amount_group',
        "groups_ddd104a7_groups"."amount_group",
        'ratio_group',
        "groups_ddd104a7_groups"."ratio_group",
        'count',
        "groups_ddd104a7_groups"."count"
      )
    ),
    '[]'
  ) as "groups"
from
  (
    select
      CAST("groups_ddd104a7"."amount" as text) as "amount_group",
      "groups_ddd104a7"."ratio" as "ratio_group",
      COUNT(*) as "count"
    from
      "public"."metrics" as "groups_ddd104a7"
    group by
      "groups_ddd104a7"."amount",
      "groups_ddd104a7"."ratio"
  ) as "groups_ddd104a7_groups"

-- metrics
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'amount',
        CAST("metrics_b773e828"."amount" as text),
        'ratio',
        "metrics_b773e828"."ratio"
      )
    ),
    '[]'
  ) as "metrics"
from
  (
    select
      *
    from
      "public"."metrics" as "metrics_b773e828"
    where
      "metrics_b773e828"."amount" >= 12345678901234567890.12345678901234567890
    limit
      10
  ) as "metrics_b773e828"
