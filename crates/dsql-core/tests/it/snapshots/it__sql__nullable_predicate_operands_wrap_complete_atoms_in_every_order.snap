-- parameters: params.required_name

-- reversed
select
  COALESCE(
    JSON_AGG(
      JSON_BUILD_OBJECT('id', "reversed_be149a76"."id")
    ),
    '[]'
  ) as "reversed"
from
  (
    select
      *
    from
      "public"."users" as "reversed_be149a76"
    where
      (
        ($1) = "reversed_be149a76"."id"
        and ($1 is not null)
      )
      or "reversed_be149a76"."name" = 'fallback'
    limit
      10
  ) as "reversed_be149a76"
-- parameters: params.id

-- seed
select
  COALESCE(
    JSON_AGG(JSON_BUILD_OBJECT('id', "seed_3acba0f5"."id")),
    '[]'
  ) as "seed"
from
  (
    select
      *
    from
      "public"."users" as "seed_3acba0f5"
    where
      (
        (
          "seed_3acba0f5"."id" = ($1)
          or (not ($1 is not null))
        )
        and (
          "seed_3acba0f5"."id" = ($2)
          or (not ($2 is not null))
        )
      )
      or (
        not (
          ($1 is not null)
          or ($2 is not null)
        )
      )
    limit
      10
  ) as "seed_3acba0f5"
-- parameters: params.left, params.right
