{"name":"PolicyAudit","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'name',\n        (\n          case\n            when (\n              ($3)\n              and \"users_99fc7350\".\"id\" = ($1)\n            ) then \"users_99fc7350\".\"name\"\n            else null\n          end\n        ),\n        'posts',\n        \"posts_json_9b3bd304\".\"posts_result_9b3bd304\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n      left join LATERAL (\n        select\n          COALESCE(\n            JSON_AGG(\n              JSON_BUILD_OBJECT('title', \"posts_9b3bd304\".\"title\")\n            ),\n            '[]'\n          ) as \"posts_result_9b3bd304\"\n        from\n          \"public\".\"posts\" as \"posts_9b3bd304\"\n        where\n          \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\"\n          and (\n            \"users_99fc7350\".\"id\" = ($1)\n            and ($2)\n          )\n      ) as \"posts_json_9b3bd304\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"users\" AS \"users\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('name', (CASE WHEN (($3) AND \"users_99fc7350\".\"id\" = ($1)) THEN \"users_99fc7350\".\"name\" ELSE NULL END), 'posts', \"posts_json_9b3bd304\".\"posts_result_9b3bd304\") AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LEFT JOIN LATERAL (SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('title', \"posts_9b3bd304\".\"title\")), '[]') AS \"posts_result_9b3bd304\" FROM \"public\".\"posts\" AS \"posts_9b3bd304\" WHERE \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\" AND (\"users_99fc7350\".\"id\" = ($1) AND ($2))) AS \"posts_json_9b3bd304\" ON true LIMIT 1) AS \"root\" ON true","parameters":[{"path":"context.user_id"},{"path":"context.can_read_posts"},