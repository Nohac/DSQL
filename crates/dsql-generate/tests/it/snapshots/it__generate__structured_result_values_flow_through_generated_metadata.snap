{"name":"Structured","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"typed_values\" as \"typed_values\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'label',\n        \"typed_values_20da7b7a\".\"label\",\n        'address',\n        CAST(\"typed_values_20da7b7a\".\"address\" as text),\n        'labels',\n        \"typed_values_20da7b7a\".\"labels\",\n        'big_values',\n        CAST(\"typed_values_20da7b7a\".\"big_values\" as text[]),\n        'nested_label',\n        \"typed_values_20da7b7a\".\"nested_label\",\n        'domain_labels',\n        \"typed_values_20da7b7a\".\"domain_labels\",\n        'labeled_values',\n        \"typed_values_20da7b7a\".\"labeled_values\"\n      ) as \"typed_values\"\n    from\n      \"public\".\"typed_values\" as \"typed_values_20da7b7a\"\n    where\n      \"typed_values_20da7b7a\".\"label\" = ($1)\n      and \"typed_values_20da7b7a\".\"address\" = ((($2)::text)::\"public\".\"address_domain\")\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"typed_values\" AS \"typed_values\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('label', \"typed_values_20da7b7a\".\"label\", 'address', CAST(\"typed_values_20da7b7a\".\"address\" AS text), 'labels', \"typed_values_20da7b7a\".\"labels\", 'big_values', CAST(\"typed_values_20da7b7a\".\"big_values\" AS text[]), 'nested_label', \"typed_values_20da7b7a\".\"nested_label\", 'domain_labels', \"typed_values_20da7b7a\".\"domain_labels\", 'labeled_values', \"typed_values_20da7b7a\".\"labeled_values\") AS \"typed_values\" FROM \"public\".\"typed_values\" AS \"typed_values_20da7b7a\" WHERE \"typed_values_20da7b7a\".\"label\" = ($1) AND \"typed_values_20da7b7a\".\"address\" = ((($2)::text)::\"public\".\"address_domain\") LIMIT 1) AS \"root\" ON true","parameters":[{"path":"params.label"},{"path":"params.address"}],"variants":[]},"result":{"fields":[