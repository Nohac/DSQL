{"name":"ByLimit","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'name',\n        \"users_99fc7350\".\"name\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"users\" AS \"users\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\", 'name', \"users_99fc7350\".\"name\") AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LIMIT 1) AS \"root\" ON true","parameters":[],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"users.name","name":"name","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":false,"access":"unconditional"}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"ByLimit","file":"queries/frontend/singular.dsql","range":{"start":0,"end":44}}]}
