RuntimeLimit
{"name":"RuntimeLimit","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\")),\n    '[]'\n  ) as \"users\"\nfrom\n  \"public\".\"users\" as \"users_99fc7350\"\nlimit\n  $1","compact_text":"SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\")), '[]') AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LIMIT $1","parameters":[{"path":"params.count"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":false,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"}]},"params":[{"path":"params.count","data_type":"int","wire":{"encoding":"integer"},"enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"RuntimeLimit","file":"queries/frontend/singular.dsql","range":{"start":201,"end":251}}]}
