FlattenedSingular
{"name":"FlattenedSingular","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"user_id\" as \"user_id\",\n  \"root\".\"name\" as \"name\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      TO_JSON(\"users_99fc7350\".\"id\") as \"user_id\",\n      TO_JSON(\"users_99fc7350\".\"name\") as \"name\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"user_id\" AS \"user_id\", \"root\".\"name\" AS \"name\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT TO_JSON(\"users_99fc7350\".\"id\") AS \"user_id\", TO_JSON(\"users_99fc7350\".\"name\") AS \"name\" FROM \"public\".\"users\" AS \"users_99fc7350\" LIMIT 1) AS \"root\" ON true","parameters":[],"variants":[]},"result":{"fields":[{"path":"user_id","name":"user_id","parent_path":"","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":true,"access":"unconditional"},{"path":"name","name":"name","parent_path":"","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"unconditional"}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"FlattenedSingular","file":"queries/frontend/singular.dsql","range":{"start":371,"end":437}}]}
