ByCompositeKey
{"name":"ByCompositeKey","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"dsql_root\".\"memberships\" as \"memberships\"\nfrom\n  (\n    select\n      1) as \"dsql_singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT('locale', \"memberships_c189f2a4\".\"locale\") as \"memberships\"\n    from\n      \"public\".\"memberships\" as \"memberships_c189f2a4\"\n    where\n      \"memberships_c189f2a4\".\"tenant_id\" = ($1)\n      and \"memberships_c189f2a4\".\"user_id\" = ($2)\n  ) as \"dsql_root\" on true","parameters":[{"path":"params.tenant"},{"path":"params.user"}],"variants":[]},"result":{"fields":[{"path":"memberships","name":"memberships","parent_path":"","kind":"object","data_type":"object","nullable":true},{"path":"memberships.locale","name":"locale","parent_path":"memberships","kind":"scalar","data_type":"text","nullable":false}]},"params":[{"path":"params.tenant","data_type":"uuid","enum_values":[],"required":true,"nullable":false},{"path":"params.user","data_type":"uuid","enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"ByCompositeKey","file":"queries/frontend/singular.dsql","range":{"start":98,"end":200}}]}
