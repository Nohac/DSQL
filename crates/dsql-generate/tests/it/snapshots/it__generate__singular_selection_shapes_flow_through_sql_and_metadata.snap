NestedLimit
{"name":"NestedLimit","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"dsql_root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"dsql_singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'latest_post',\n        \"latest_post_json_540ec775\".\"latest_post_result_540ec775\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT('title', \"latest_post_540ec775\".\"title\") as \"latest_post_result_540ec775\"\n        from\n          \"public\".\"posts\" as \"latest_post_540ec775\"\n        where\n          \"latest_post_540ec775\".\"user_id\" = \"users_99fc7350\".\"id\"\n        order by\n          \"latest_post_540ec775\".\"created_at\" desc\n        limit\n          1\n      ) as \"latest_post_json_540ec775\" on true\n    limit\n      1\n  ) as \"dsql_root\" on true","parameters":[],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"object","data_type":"object","nullable":true},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","data_type":"uuid","nullable":false},{"path":"users.latest_post","name":"latest_post","parent_path":"users","kind":"object","data_type":"object","nullable":true},{"path":"users.latest_post.title","name":"title","parent_path":"users.latest_post","kind":"scalar","data_type":"text","nullable":true}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"NestedLimit","file":"queries/frontend/singular.dsql","range":{"start":252,"end":370}}]}
