ByCompositeKey
{"name":"ByCompositeKey","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"memberships\" as \"memberships\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT('locale', \"memberships_c189f2a4\".\"locale\") as \"memberships\"\n    from\n      \"public\".\"memberships\" as \"memberships_c189f2a4\"\n    where\n      \"memberships_c189f2a4\".\"tenant_id\" = ($1)\n      and \"memberships_c189f2a4\".\"user_id\" = ($2)\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"memberships\" AS \"memberships\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('locale', \"memberships_c189f2a4\".\"locale\") AS \"memberships\" FROM \"public\".\"memberships\" AS \"memberships_c189f2a4\" WHERE \"memberships_c189f2a4\".\"tenant_id\" = ($1) AND \"memberships_c189f2a4\".\"user_id\" = ($2)) AS \"root\" ON true","parameters":[{"path":"params.tenant"},{"path":"params.user"}],"variants":[]},"result":{"fields":[{"path":"memberships","name":"memberships","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"unconditional"},{"path":"memberships.locale","name":"locale","parent_path":"memberships","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":false,"access":"unconditional"}]},"params":[{"path":"params.tenant","data_type":"uuid","wire":{"encoding":"uuid"},"enum_values":[],"required":true,"nullable":false},{"path":"params.user","data_type":"uuid","wire":{"encoding":"uuid"},"enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"ByCompositeKey","file":"queries/frontend/singular.dsql","range":{"start":98,"end":200}}]}
