NestedLimit
{"name":"NestedLimit","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'latest_post',\n        \"latest_post_json_540ec775\".\"latest_post_result_540ec775\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT('title', \"latest_post_540ec775\".\"title\") as \"latest_post_result_540ec775\"\n        from\n          \"public\".\"posts\" as \"latest_post_540ec775\"\n        where\n          \"latest_post_540ec775\".\"user_id\" = \"users_99fc7350\".\"id\"\n        order by\n          \"latest_post_540ec775\".\"created_at\" desc\n        limit\n          1\n      ) as \"latest_post_json_540ec775\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"users\" AS \"users\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\", 'latest_post', \"latest_post_json_540ec775\".\"latest_post_result_540ec775\") AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('title', \"latest_post_540ec775\".\"title\") AS \"latest_post_result_540ec775\" FROM \"public\".\"posts\" AS \"latest_post_540ec775\" WHERE \"latest_post_540ec775\".\"user_id\" = \"users_99fc7350\".\"id\" ORDER BY \"latest_post_540ec775\".\"created_at\" DESC LIMIT 1) AS \"latest_post_json_540ec775\" ON true LIMIT 1) AS \"root\" ON true","parameters":[],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"users.latest_post","name":"latest_post","parent_path":"users","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"unconditional"},{"path":"users.latest_post.title","name":"title","parent_path":"users.latest_post","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"unconditional"}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"NestedLimit","file":"queries/frontend/singular.dsql","range":{"start":252,"end":370}}]}
