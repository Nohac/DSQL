{"name":"ByKey","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"dsql_root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"dsql_singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'name',\n        \"users_99fc7350\".\"name\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    where\n      \"users_99fc7350\".\"id\" = ($1)\n  ) as \"dsql_root\" on true","parameters":[{"path":"params.id"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"object","data_type":"object","nullable":true},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","data_type":"uuid","nullable":false},{"path":"users.name","name":"name","parent_path":"users","kind":"scalar","data_type":"text","nullable":false}]},"params":[{"path":"params.id","data_type":"uuid","enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"ByKey","file":"queries/frontend/singular.dsql","range":{"start":45,"end":97}}]}
