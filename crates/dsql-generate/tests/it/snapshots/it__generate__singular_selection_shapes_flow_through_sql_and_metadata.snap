FlattenedSingular
{"name":"FlattenedSingular","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"dsql_root\".\"user_id\" as \"user_id\",\n  \"dsql_root\".\"name\" as \"name\"\nfrom\n  (\n    select\n      1) as \"dsql_singleton\"\n  left join LATERAL (\n    select\n      TO_JSON(\"users_99fc7350\".\"id\") as \"user_id\",\n      TO_JSON(\"users_99fc7350\".\"name\") as \"name\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    limit\n      1\n  ) as \"dsql_root\" on true","parameters":[],"variants":[]},"result":{"fields":[{"path":"user_id","name":"user_id","parent_path":"","kind":"scalar","data_type":"uuid","nullable":true},{"path":"name","name":"name","parent_path":"","kind":"scalar","data_type":"text","nullable":true}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"FlattenedSingular","file":"queries/frontend/singular.dsql","range":{"start":371,"end":437}}]}
