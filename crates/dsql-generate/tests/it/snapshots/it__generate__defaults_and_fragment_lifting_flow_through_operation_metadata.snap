{"name":"Bound","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'posts',\n        \"posts_json_9b3bd304\".\"posts_result_9b3bd304\"\n      )\n    ),\n    '[]'\n  ) as \"users\"\nfrom\n  \"public\".\"users\" as \"users_99fc7350\"\n  left join LATERAL (\n    select\n      COALESCE(\n        JSON_AGG(JSON_BUILD_OBJECT('id', \"posts_9b3bd304\".\"id\")),\n        '[]'\n      ) as \"posts_result_9b3bd304\"\n    from\n      (\n        select\n          *\n        from\n          \"public\".\"posts\" as \"posts_9b3bd304\"\n        where\n          \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\"\n          and \"posts_9b3bd304\".\"created_at\" >= ($1)\n        limit\n          5\n      ) as \"posts_9b3bd304\"\n  ) as \"posts_json_9b3bd304\" on true","compact_text":"SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('posts', \"posts_json_9b3bd304\".\"posts_result_9b3bd304\")), '[]') AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LEFT JOIN LATERAL (SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"posts_9b3bd304\".\"id\")), '[]') AS \"posts_result_9b3bd304\" FROM (SELECT * FROM \"public\".\"posts\" AS \"posts_9b3bd304\" WHERE \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\" AND \"posts_9b3bd304\".\"created_at\" >= ($1) LIMIT 5) AS \"posts_9b3bd304\") AS \"posts_json_9b3bd304\" ON true","parameters":[{"path":"params.since"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"users.posts","name":"posts","parent_path":"users","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"users.posts.id","name":"id","parent_path":"users.posts","kind":"scalar","