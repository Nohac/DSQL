{"name":"ClosedVariants","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\")\n      order by\n        case\n          when '{{params.direction}}' = 'asc' then \"users_99fc7350\".\"name\"\n        end asc,\n        case\n          when '{{params.direction}}' = 'desc' then \"users_99fc7350\".\"name\"\n        end desc\n    ),\n    '[]'\n  ) as \"users\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    where\n      \"users_99fc7350\".\"name\" {{params.operator}} 'A'\n    order by\n      \"users_99fc7350\".\"name\" {{params.direction}}\n  ) as \"users_99fc7350\"","compact_text":"SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\") ORDER BY CASE WHEN '{{params.direction}}' = 'asc' THEN \"users_99fc7350\".\"name\" END ASC, CASE WHEN '{{params.direction}}' = 'desc' THEN \"users_99fc7350\".\"name\" END DESC), '[]') AS \"users\" FROM (SELECT * FROM \"public\".\"users\" AS \"users_99fc7350\" WHERE \"users_99fc7350\".\"name\" {{params.operator}} 'A' ORDER BY \"users_99fc7350\".\"name\" {{params.direction}}) AS \"users_99fc7350\"","parameters":[],"variants":[{"path":"params.operator","cases":[{"value":"==","text":"="},{"value":"like","text":"like"}]},{"path":"params.direction","cases":[{"value":"asc","text":"asc"},{"value":"desc","text":"desc"}]}]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"}]},"params":[{"path":"params.direction","data_type":"text","wire":{"encoding":"text"},"validation":{},"closed_v