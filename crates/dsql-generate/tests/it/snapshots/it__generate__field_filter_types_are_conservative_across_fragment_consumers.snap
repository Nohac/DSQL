{"name":"FilteredPosts","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"posts_ed412d1c\".\"id\",\n        'users',\n        \"users_json_bc98860c\".\"users_result_bc98860c\",\n        'owner_name',\n        \"users_json_7fc74404\".\"owner_name\"\n      )\n    ),\n    '[]'\n  ) as \"posts\"\nfrom\n  \"public\".\"posts\" as \"posts_ed412d1c\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_bc98860c\".\"id\",\n        'name',\n        (\n          case\n            when ($1) then \"users_bc98860c\".\"name\"\n            else null\n          end\n        )\n      ) as \"users_result_bc98860c\"\n    from\n      \"public\".\"users\" as \"users_bc98860c\"\n    where\n      \"users_bc98860c\".\"id\" = \"posts_ed412d1c\".\"user_id\"\n      and ($1)\n  ) as \"users_json_bc98860c\" on true\n  left join LATERAL (\n    select\n      (\n        case\n          when ($1) then \"users_7fc74404\".\"name\"\n          else null\n        end\n      ) as \"owner_name\"\n    from\n      \"public\".\"users\" as \"users_7fc74404\"\n    where\n      \"users_7fc74404\".\"id\" = \"posts_ed412d1c\".\"user_id\"\n      and ($1)\n  ) as \"users_json_7fc74404\" on true","compact_text":"SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"posts_ed412d1c\".\"id\", 'users', \"users_json_bc98860c\".\"users_result_bc98860c\", 'owner_name', \"users_json_7fc74404\".\"owner_name\")), '[]') AS \"posts\" FROM \"public\".\"posts\" AS \"posts_ed412d1c\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"users_bc98860c\".\"id\", 'name', (CASE WHEN ($1) THEN \"users_bc98860c\".\"name\" ELSE NULL END)) AS \"users_result_bc98860c\" FROM \"public\".\"users\" AS \"users_bc98860c\" WHERE \"users_bc98860c\".\"id\" = \"posts_ed412d1c\".\"user_id\" AND ($1)) AS \"users_json_bc98860c\" ON true LEFT JOIN LATERAL (SELECT (CASE WHEN ($1) THEN \"users_7fc74404\".\"name\" ELSE NULL END) AS \"owner_name\" FROM \"public\".\"users\" AS \"users_7fc74404\" WHERE \"users_7fc74404\".\"id\" = \"posts_ed412d1c\".\"user_id\" AND ($1)) AS \"users_json_7fc74404\" ON true","parameters":[{"path":"context.can_read_users"}],"variants":[]},"result":{"fields":[{"path":"posts","name":"posts","parent_path":"","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":false,"access":"unconditional"},{"path":"posts.id","name":"id","parent_path":"posts","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"posts.users","name":"users","parent_path":"posts","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"context_only"},{"path":"posts.users.id","name":"id","parent_path":"posts.users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"posts.users.name","name":"name","parent_path":"posts.users","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"context_only"},{"path":"posts.owner_name","name":"owner_name","parent_path":"posts","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"context_only"}]},"params":[],"input":[],"context":[{"path":"context.can_read_users","data_type":"boolean","wire":{"encoding":"boolean"},"validation":{},"enum_values":[],"required":true,"nullable":false}],"dynamic_inputs":[],"policies":[{"scope":"frontend","defined_in":"frontend","name":"PostPrivacy","default_active":true,"enforcement":"always","conditions":[],"context":["context.can_read_users"],"source":{"id":"frontend::PostPrivacy","file":"queries/frontend/filtered.dsql","range":{"start":94,"end":181}},"applications":[