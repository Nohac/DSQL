{"name":"FilteredUsers","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'name',\n        (\n          case\n            when ($1) then \"users_99fc7350\".\"name\"\n            else null\n          end\n        ),\n        'posts',\n        \"posts_json_9b3bd304\".\"posts_result_9b3bd304\",\n        'post_stats',\n        \"post_stats_json_f1ab13d3\".\"post_stats_result_f1ab13d3\"\n      )\n    ),\n    '[]'\n  ) as \"users\"\nfrom\n  \"public\".\"users\" as \"users_99fc7350\"\n  left join LATERAL (\n    select\n      COALESCE(\n        JSON_AGG(\n          JSON_BUILD_OBJECT(\n            'id',\n            \"posts_9b3bd304\".\"id\",\n            'title',\n            \"posts_9b3bd304\".\"title\"\n          )\n        ),\n        '[]'\n      ) as \"posts_result_9b3bd304\"\n    from\n      \"public\".\"posts\" as \"posts_9b3bd304\"\n    where\n      \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\"\n      and ($1)\n  ) as \"posts_json_9b3bd304\" on true\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'count',\n        CAST(COUNT(*) as text),\n        'latest',\n        MAX(\"post_stats_f1ab13d3\".\"created_at\")\n      ) as \"post_stats_result_f1ab13d3\"\n    from\n      \"public\".\"posts\" as \"post_stats_f1ab13d3\"\n    where\n      \"post_stats_f1ab13d3\".\"user_id\" = \"users_99fc7350\".\"id\"\n      and ($1)\n  ) as \"post_stats_json_f1ab13d3\" on true","compact_text":"SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\", 'name', (CASE WHEN ($1) THEN \"users_99fc7350\".\"name\" ELSE NULL END), 'posts', \"posts_json_9b3bd304\".\"posts_result_9b3bd304\", 'post_stats', \"post_stats_json_f1ab13d3\".\"post_stats_result_f1ab13d3\")), '[]') AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LEFT JOIN LATERAL (SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('id', \"posts_9b3bd304\".\"id\", 'title', \"posts_9b3bd304\".\"title\")), '[]') AS \"posts_result_9b3bd304\" FROM \"public\".\"posts\" AS \"posts_9b3bd304\" WHERE \"posts_9b3bd304\".\"user_id\" = \"users_99fc7350\".\"id\" AND ($1)) AS \"posts_json_9b3bd304\" ON true LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('count', CAST(COUNT(*) AS text), 'latest', MAX(\"post_stats_f1ab13d3\".\"created_at\")) AS \"post_stats_result_f1ab13d3\" FROM \"public\".\"posts\" AS \"post_stats_f1ab13d3\" WHERE \"post_stats_f1ab13d3\".\"user_id\" = \"users_99fc7350\".\"id\" AND ($1)) AS \"post_stats_json_f1ab13d3\" ON true","parameters":[{"path":"context.can_read_users"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":false,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"users.name","name":"name","parent_path":"users","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"context_only"},{"path":"users.posts","name":"posts","parent_path":"users","kind":"array","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":false,"access":"context_only"},{"path":"users.posts.id","name":"id","parent_path":"users.posts","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"users.posts.title","name":"title","parent_path":"users.posts","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":true,"access":"unconditional"},{"path":"users.post_stats","name":"post_stats","parent_path":"users","kind":"object","value_type":{"shape":"object","na