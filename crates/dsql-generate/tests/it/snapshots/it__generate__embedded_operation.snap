{"name":"TitlePanel","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"title\" as \"title\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"title_d4d9f554\".\"id\",\n        'title',\n        \"title_d4d9f554\".\"title\",\n        'kind_type',\n        \"kind_type_json_d78b0eec\".\"kind_type_result_d78b0eec\"\n      ) as \"title\"\n    from\n      \"public\".\"title\" as \"title_d4d9f554\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT('kind', \"kind_type_d78b0eec\".\"kind\") as \"kind_type_result_d78b0eec\"\n        from\n          \"public\".\"kind_type\" as \"kind_type_d78b0eec\"\n        where\n          \"kind_type_d78b0eec\".\"id\" = \"title_d4d9f554\".\"kind_id\"\n      ) as \"kind_type_json_d78b0eec\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"title\" AS \"title\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"title_d4d9f554\".\"id\", 'title', \"title_d4d9f554\".\"title\", 'kind_type', \"kind_type_json_d78b0eec\".\"kind_type_result_d78b0eec\") AS \"title\" FROM \"public\".\"title\" AS \"title_d4d9f554\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('kind', \"kind_type_d78b0eec\".\"kind\") AS \"kind_type_result_d78b0eec\" FROM \"public\".\"kind_type\" AS \"kind_type_d78b0eec\" WHERE \"kind_type_d78b0eec\".\"id\" = \"title_d4d9f554\".\"kind_id\") AS \"kind_type_json_d78b0eec\" ON true LIMIT 1) AS \"root\" ON true","parameters":[],"variants":[]},"result":{"fields":[{"path":"title","name":"title","parent_path":"","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":true,"access":"unconditional"},{"path":"title.id","name":"id","parent_path":"title","kind":"scalar","data_type":"int","wire":{"encoding":"integer"},"nullable":false,"access":"unconditional"},{"path":"title.title","name":"title","parent_path":"title","kind":"sc