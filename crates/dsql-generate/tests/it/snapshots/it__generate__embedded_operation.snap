{"name":"TitlePanel","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"title_d4d9f554\".\"id\",\n        'title',\n        \"title_d4d9f554\".\"title\",\n        'kind_type',\n        \"kind_type_json_d78b0eec\".\"kind_type_result_d78b0eec\"\n      )\n    ),\n    '[]'\n  ) as \"title\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"title\" as \"title_d4d9f554\"\n    limit\n      1\n  ) as \"title_d4d9f554\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT('kind', \"kind_type_d78b0eec\".\"kind\") as \"kind_type_result_d78b0eec\"\n    from\n      \"public\".\"kind_type\" as \"kind_type_d78b0eec\"\n    where\n      \"kind_type_d78b0eec\".\"id\" = \"title_d4d9f554\".\"kind_id\"\n  ) as \"kind_type_json_d78b0eec\" on true","parameters":[],"variants":[]},"result":{"fields":[{"path":"title","name":"title","parent_path":"","kind":"array","data_type":"object","nullable":false},{"path":"title.id","name":"id","parent_path":"title","kind":"scalar","data_type":"int","nullable":false},{"path":"title.title","name":"title","parent_path":"title","kind":"scalar","data_type":"text","nullable":false},{"path":"title.kind_type","name":"kind_type","parent_path":"title","kind":"object","data_type":"object","nullable":false},{"path":"title.kind_type.kind","name":"kind","parent_path":"title.kind_type","kind":"scalar","data_type":"text","nullable":false}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"title","fragment":"TitleBits"}],"source_map":[{"id":"TitlePanel","file":"src/components/TitlePanel.ts","range":{"start":70,"end":163}}]}
