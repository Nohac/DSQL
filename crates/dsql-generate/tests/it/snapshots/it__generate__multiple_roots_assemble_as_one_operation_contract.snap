{"name":"UserOverview","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root_0\".\"summary\" as \"summary\",\n  \"root_1\".\"first\" as \"first\",\n  \"root_2\".\"post_count\" as \"post_count\"\nfrom\n  (\n    select\n      JSON_BUILD_OBJECT('count', COUNT(*)) as \"summary\"\n    from\n      \"public\".\"users\" as \"summary_fd76d138\"\n    where\n      \"summary_fd76d138\".\"name\" = ($1)\n      or (not ($1 is not null))\n  ) as \"root_0\"\n  cross join (\n    select\n      \"root\".\"first\" as \"first\"\n    from\n      (\n        select\n          1) as \"singleton\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT(\n            'id',\n            \"first_a11e3c4e\".\"id\",\n            'name',\n            \"first_a11e3c4e\".\"name\"\n          ) as \"first\"\n        from\n          \"public\".\"users\" as \"first_a11e3c4e\"\n        where\n          \"first_a11e3c4e\".\"name\" = ($1)\n          or (not ($1 is not null))\n        limit\n          1\n      ) as \"root\" on true\n  ) as \"root_1\"\n  cross join (\n    select\n      TO_JSON(COUNT(*)) as \"post_count\"\n    from\n      \"public\".\"posts\" as \"posts_ed412d1c\"\n  ) as \"root_2\"","parameters":[{"path":"params.name"}],"variants":[]},"result":{"fields":[{"path":"summary","name":"summary","parent_path":"","kind":"object","data_type":"object","nullable":false,"access":"unconditional"},{"path":"summary.count","name":"count","parent_path":"summary","kind":"scalar","data_type":"int","nullable":false,"access":"unconditional"},{"path":"first","name":"first","parent_path":"","kind":"object","data_type":"object","nullable":true,"access":"unconditional"},{"path":"first.id","name":"id","parent_path":"first","kind":"scalar","data_type":"uuid","nullable":false,"access":"unconditional"},{"path":"first.name","name":"name","parent_path":"first","kind":"scalar","data_type":"text","nullable":false,"access":"unconditional"},{"path":"post_count","name":"post_count","parent_path":"","kind":"scalar","data_type":"int","nullable":false,"access":"unconditional"}]},"params":[{"path":"params.name","data_type":"text","enum_values":[],"required":false,"nullable":true,"default":{"kind":"null"}}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"first","fragment":"UserBits"}],"source_map":[{"id":"UserOverview","file":"queries/frontend/multiple-roots.dsql","range":{"start":38,"end":270}}]}
