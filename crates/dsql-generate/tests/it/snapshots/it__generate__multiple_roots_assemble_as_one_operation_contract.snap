{"name":"UserOverview","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root_0\".\"summary\" as \"summary\",\n  \"root_1\".\"first\" as \"first\",\n  \"root_2\".\"post_count\" as \"post_count\"\nfrom\n  (\n    select\n      JSON_BUILD_OBJECT('count', CAST(COUNT(*) as text)) as \"summary\"\n    from\n      \"public\".\"users\" as \"summary_fd76d138\"\n    where\n      \"summary_fd76d138\".\"name\" = ($1)\n      or (not ($1 is not null))\n  ) as \"root_0\"\n  cross join (\n    select\n      \"root\".\"first\" as \"first\"\n    from\n      (\n        select\n          1) as \"singleton\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT(\n            'id',\n            \"first_a11e3c4e\".\"id\",\n            'name',\n            \"first_a11e3c4e\".\"name\"\n          ) as \"first\"\n        from\n          \"public\".\"users\" as \"first_a11e3c4e\"\n        where\n          \"first_a11e3c4e\".\"name\" = ($1)\n          or (not ($1 is not null))\n        limit\n          1\n      ) as \"root\" on true\n  ) as \"root_1\"\n  cross join (\n    select\n      TO_JSON(CAST(COUNT(*) as text)) as \"post_count\"\n    from\n      \"public\".\"posts\" as \"posts_ed412d1c\"\n  ) as \"root_2\"","compact_text":"SELECT \"root_0\".\"summary\" AS \"summary\", \"root_1\".\"first\" AS \"first\", \"root_2\".\"post_count\" AS \"post_count\" FROM (SELECT JSON_BUILD_OBJECT('count', CAST(COUNT(*) AS text)) AS \"summary\" FROM \"public\".\"users\" AS \"summary_fd76d138\" WHERE \"summary_fd76d138\".\"name\" = ($1) OR (NOT ($1 IS NOT NULL))) AS \"root_0\" CROSS JOIN (SELECT \"root\".\"first\" AS \"first\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"first_a11e3c4e\".\"id\", 'name', \"first_a11e3c4e\".\"name\") AS \"first\" FROM \"public\".\"users\" AS \"first_a11e3c4e\" WHERE \"first_a11e3c4e\".\"name\" = ($1) OR (NOT ($1 IS NOT NULL)) LIMIT 1) AS \"root\" ON true) AS \"root_1\" CROSS JOIN (SELECT TO_JSON(CAST(COUNT(*) AS text)) AS \"post_count\" FROM \"public\".\"posts\" AS \"posts_ed412d1c\") AS \"root_2\"","parameters":[{"path":"params.name"}],"variants":[]},"result":{"fields":[{"path":"summary","name":"summary","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":false,"access":"unconditional"},{"path":"summary.count","name":"count","parent_path":"summary","kind":"scalar","value_type":{"shape":"scalar","name":"bigint","wire":{"encoding":"big_integer"}},"nullable":false,"access":"unconditional"},{"path":"first","name":"first","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"}},"nullable":true,"access":"unconditional"},{"path":"first.id","name":"id","parent_path":"first","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"}},"nullable":false,"access":"unconditional"},{"path":"first.name","name":"name","parent_path":"first","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"}},"nullable":false,"access":"unconditional"},{"path":"post_count","name":"post_count","parent_path":"","kind":"scalar","value_type":{"shape":"scalar","name":"bigint","wire":{"encoding":"big_integer"}},"nullable":false,"access":"unconditional"}]},"params":[{"path":"params.name","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":false,"nullable":true,"default":{"kind":"null"}}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"first","fragment":"UserBits"}],"source_map":[{"id":"UserOverview","file":"queries/frontend/multiple-roots.dsql","range":{"start":38,"end":270}}]}
