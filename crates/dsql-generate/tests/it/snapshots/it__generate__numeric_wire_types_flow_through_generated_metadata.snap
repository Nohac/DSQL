{"name":"NumericSummary","kind":"query","sql":{"dialect":"postgres","text":"select\n  JSON_BUILD_OBJECT(\n    'total_amount',\n    CAST(SUM(\"summary_bea0cdc1\".\"amount\") as text),\n    'average_amount',\n    CAST(AVG(\"summary_bea0cdc1\".\"amount\") as text),\n    'total_ratio',\n    SUM(\"summary_bea0cdc1\".\"ratio\"),\n    'average_ratio',\n    AVG(\"summary_bea0cdc1\".\"ratio\")\n  ) as \"summary\"\nfrom\n  \"public\".\"metrics\" as \"summary_bea0cdc1\"","parameters":[],"variants":[]},"result":{"fields":[{"path":"summary","name":"summary","parent_path":"","kind":"object","data_type":"object","nullable":false},{"path":"summary.total_amount","name":"total_amount","parent_path":"summary","kind":"scalar","data_type":"numeric","nullable":true},{"path":"summary.average_amount","name":"average_amount","parent_path":"summary","kind":"scalar","data_type":"numeric","nullable":true},{"path":"summary.total_ratio","name":"total_ratio","parent_path":"summary","kind":"scalar","data_type":"float","nullable":true},{"path":"summary.average_ratio","name":"average_ratio","parent_path":"summary","kind":"scalar","data_type":"float","nullable":true}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"NumericSummary","file":"queries/frontend/numeric.dsql","range":{"start":105,"end":286}}]}
