{"name":"FilteredOwner","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"posts\" as \"posts\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"posts_ed412d1c\".\"id\",\n        'users',\n        \"users_json_bc98860c\".\"users_result_bc98860c\",\n        'owner_id',\n        \"users_json_7fc74404\".\"owner_id\",\n        'owner_name',\n        \"users_json_7fc74404\".\"owner_name\"\n      ) as \"posts\"\n    from\n      \"public\".\"posts\" as \"posts_ed412d1c\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT(\n            'id',\n            \"users_bc98860c\".\"id\",\n            'name',\n            \"users_bc98860c\".\"name\"\n          ) as \"users_result_bc98860c\"\n        from\n          \"public\".\"users\" as \"users_bc98860c\"\n        where\n          \"users_bc98860c\".\"id\" = \"posts_ed412d1c\".\"user_id\"\n          and \"users_bc98860c\".\"name\" <> 'hidden'\n      ) as \"users_json_bc98860c\" on true\n      left join LATERAL (\n        select\n          \"users_7fc74404\".\"id\" as \"owner_id\",\n          \"users_7fc74404\".\"name\" as \"owner_name\"\n        from\n          \"public\".\"users\" as \"users_7fc74404\"\n        where\n          \"users_7fc74404\".\"id\" = \"posts_ed412d1c\".\"user_id\"\n          and \"users_7fc74404\".\"name\" <> 'hidden'\n      ) as \"users_json_7fc74404\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"posts\" AS \"posts\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"posts_ed412d1c\".\"id\", 'users', \"users_json_bc98860c\".\"users_result_bc98860c\", 'owner_id', \"users_json_7fc74404\".\"owner_id\", 'owner_name', \"users_json_7fc74404\".\"owner_name\") AS \"posts\" FROM \"public\".\"posts\" AS \"posts_ed412d1c\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"users_bc98860c\".\"id\", 'name', \"users_bc98860c\".\"name\") AS \"users_result_bc98860c\" FROM \"public\".\"users\" AS \"users_bc98860c\" WHERE \"users_bc98860c\".\"id\" = \"posts_ed412d1c\".\"user_id\" AND \"users_bc98860c\".\"name\" <> 'hidden') AS \"users_json_bc98860c\" ON true LEFT JOIN LATERAL (SELECT \"users_7fc74404\".\"id\" AS \"owner_id\", \"users_7fc74404\".\"name\" AS \"owner_name\" FROM \"public\".\"users\" AS \"users_7fc74404\" WHERE \"users_7fc74404\".\"id\" = \"posts_ed412d1c\".\"user_id\" AND \"users_7fc74404\".\"name\" <> 'hidden') AS \"users_json_7fc74404\" ON true LIMIT 1) AS \"root\" ON true","parameters":[],"variants":[]},"result":{"fields":[{"path":"posts","name":"posts","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"values":[]}},"nullable":true,"access":"unconditional"},{"path":"posts.id","name":"id","parent_path":"posts","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"posts.users","name":"users","parent_path":"posts","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"values":[]}},"nullable":true,"access":"row_dependent"},{"path":"posts.users.id","name":"id","parent_path":"posts.users","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"posts.users.name","name":"name","parent_path":"posts.users","kind":"scalar","value_type":{"shape":"scalar","name":"text","display":"text","wire":{"encoding":"text"},"closed_values":{"values":[]}},"nullable":false,"access":"unconditional"},{"path":"posts.owner_id","name":"owner_id","parent_path":"posts","kind":"scalar","value_type":{"shape":"scalar","name":"uuid","display":"uuid","wire":{"encoding":"uuid"},"closed_values":{"values":