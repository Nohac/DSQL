{"name":"NativeEnums","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"enum_records\" as \"enum_records\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'status',\n        CAST(\"enum_records_9195a94c\".\"status\" as text),\n        'domain_status',\n        CAST(\"enum_records_9195a94c\".\"domain_status\" as text),\n        'statuses',\n        CAST(\"enum_records_9195a94c\".\"statuses\" as text[])\n      ) as \"enum_records\"\n    from\n      \"public\".\"enum_records\" as \"enum_records_9195a94c\"\n    where\n      \"enum_records_9195a94c\".\"status\" = ((($1)::text)::\"public\".\"status\")\n      and (\n        \"enum_records_9195a94c\".\"status\" = ((($2)::text)::\"public\".\"status\")\n        and (\n          \"enum_records_9195a94c\".\"status\" = ANY((($3)::text[])::\"public\".\"status\"[])\n        )\n      )\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"enum_records\" AS \"enum_records\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('status', CAST(\"enum_records_9195a94c\".\"status\" AS text), 'domain_status', CAST(\"enum_records_9195a94c\".\"domain_status\" AS text), 'statuses', CAST(\"enum_records_9195a94c\".\"statuses\" AS text[])) AS \"enum_records\" FROM \"public\".\"enum_records\" AS \"enum_records_9195a94c\" WHERE \"enum_records_9195a94c\".\"status\" = ((($1)::text)::\"public\".\"status\") AND (\"enum_records_9195a94c\".\"status\" = ((($2)::text)::\"public\".\"status\") AND (\"enum_records_9195a94c\".\"status\" = ANY((($3)::text[])::\"public\".\"status\"[]))) LIMIT 1) AS \"root\" ON true","parameters":[{"path":"context.status"},{"path":"params.status"},{"path":"params.statuses"}],"variants":[]},"result":{"fields":[{"path":"enum_records","name":"enum_records","parent_path":"","kind":"object","value_type":{"shape":"object","name":"object","wire":{"encoding":"unsupported"},"closed_values":{"val