GroupedRoot
{"name":"GroupedRoot","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'label',\n        \"user_groups_f6ccf13c_groups_cc6d42bd\".\"label\",\n        'count',\n        \"user_groups_f6ccf13c_groups_cc6d42bd\".\"count\",\n        'latest_name',\n        \"user_groups_f6ccf13c_groups_cc6d42bd\".\"latest_name\"\n      )\n    ),\n    '[]'\n  ) as \"user_groups\"\nfrom\n  (\n    select\n      \"user_groups_f6ccf13c\".\"name\" as \"label\",\n      COUNT(*) as \"count\",\n      MAX(\"user_groups_f6ccf13c\".\"name\") as \"latest_name\"\n    from\n      \"public\".\"users\" as \"user_groups_f6ccf13c\"\n    group by\n      \"user_groups_f6ccf13c\".\"name\"\n  ) as \"user_groups_f6ccf13c_groups_cc6d42bd\"","parameters":[],"variants":[]},"result":{"fields":[{"path":"user_groups","name":"user_groups","parent_path":"","kind":"array","data_type":"object","nullable":false},{"path":"user_groups.label","name":"label","parent_path":"user_groups","kind":"scalar","data_type":"text","nullable":false},{"path":"user_groups.count","name":"count","parent_path":"user_groups","kind":"scalar","data_type":"int","nullable":false},{"path":"user_groups.latest_name","name":"latest_name","parent_path":"user_groups","kind":"scalar","data_type":"text","nullable":false}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"GroupedRoot","file":"queries/frontend/aggregates.dsql","range":{"start":511,"end":624}}]}
