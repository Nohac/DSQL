NestedStats
{"name":"NestedStats","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"users\" as \"users\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'post_stats',\n        \"post_stats_json_f1ab13d3\".\"post_stats_result_f1ab13d3\",\n        'post_groups',\n        \"post_groups_json_412749f0\".\"post_groups_result_412749f0\"\n      ) as \"users\"\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n      left join LATERAL (\n        select\n          JSON_BUILD_OBJECT(\n            'count',\n            CAST(COUNT(*) as text),\n            'latest',\n            MAX(\"post_stats_f1ab13d3\".\"created_at\")\n          ) as \"post_stats_result_f1ab13d3\"\n        from\n          \"public\".\"posts\" as \"post_stats_f1ab13d3\"\n        where\n          \"post_stats_f1ab13d3\".\"user_id\" = \"users_99fc7350\".\"id\"\n          and \"post_stats_f1ab13d3\".\"title\" = ($1)\n      ) as \"post_stats_json_f1ab13d3\" on true\n      left join LATERAL (\n        select\n          COALESCE(\n            JSON_AGG(\n              JSON_BUILD_OBJECT(\n                'title_group',\n                \"post_groups_412749f0_groups_94123404\".\"title_group\",\n                'count',\n                \"post_groups_412749f0_groups_94123404\".\"count\",\n                'latest_group',\n                \"post_groups_412749f0_groups_94123404\".\"latest_group\"\n              )\n            ),\n            '[]'\n          ) as \"post_groups_result_412749f0\"\n        from\n          (\n            select\n              \"post_groups_412749f0\".\"title\" as \"title_group\",\n              CAST(COUNT(*) as text) as \"count\",\n              MAX(\"post_groups_412749f0\".\"created_at\") as \"latest_group\"\n            from\n              \"public\".\"posts\" as \"post_groups_412749f0\"\n            where\n              \"post_groups_412749f0\".\"user_id\" = \"users_99fc7350\".\"id\"\n            group by\n              \"post_groups_412749f0\".\"title\"\n          ) as \"post_groups_412749f0_groups_94123404\"\n      ) as \"post_groups_json_412749f0\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"users\" AS \"users\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"users_99fc7350\".\"id\", 'post_stats', \"post_stats_json_f1ab13d3\".\"post_stats_result_f1ab13d3\", 'post_groups', \"post_groups_json_412749f0\".\"post_groups_result_412749f0\") AS \"users\" FROM \"public\".\"users\" AS \"users_99fc7350\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('count', CAST(COUNT(*) AS text), 'latest', MAX(\"post_stats_f1ab13d3\".\"created_at\")) AS \"post_stats_result_f1ab13d3\" FROM \"public\".\"posts\" AS \"post_stats_f1ab13d3\" WHERE \"post_stats_f1ab13d3\".\"user_id\" = \"users_99fc7350\".\"id\" AND \"post_stats_f1ab13d3\".\"title\" = ($1)) AS \"post_stats_json_f1ab13d3\" ON true LEFT JOIN LATERAL (SELECT COALESCE(JSON_AGG(JSON_BUILD_OBJECT('title_group', \"post_groups_412749f0_groups_94123404\".\"title_group\", 'count', \"post_groups_412749f0_groups_94123404\".\"count\", 'latest_group', \"post_groups_412749f0_groups_94123404\".\"latest_group\")), '[]') AS \"post_groups_result_412749f0\" FROM (SELECT \"post_groups_412749f0\".\"title\" AS \"title_group\", CAST(COUNT(*) AS text) AS \"count\", MAX(\"post_groups_412749f0\".\"created_at\") AS \"latest_group\" FROM \"public\".\"posts\" AS \"post_groups_412749f0\" WHERE \"post_groups_412749f0\".\"user_id\" = \"users_99fc7350\".\"id\" GROUP BY \"post_groups_412749f0\".\"title\") AS \"post_groups_412749f0_groups_94123404\") AS \"post_groups_json_412749f0\" ON true LIMIT 1) AS \"root\" ON true","parameters":[{"path":"input.users.body.UserStats.params.title"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":true,"access":"unconditional"},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","data_type":"uuid","wire":{"encoding":"uuid"},"nullable":false,"access":"unconditional"},{"path":"users.post_stats","name":"post_stats","parent_path":"users","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":false,"access":"unconditional"},{"path":"users.post_stats.count","name":"count","parent_path":"users.post_stats","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":false,"access":"unconditional"},{"path":"users.post_stats.latest","name":"latest","parent_path":"users.post_stats","kind":"scalar","data_type":"timestamptz","wire":{"encoding":"timestamptz"},"nullable":true,"access":"unconditional"},{"path":"users.post_groups","name":"post_groups","parent_path":"users","kind":"array","data_type":"object","wire":{"encoding":"unsupported"},"nullable":false,"access":"unconditional"},{"path":"users.post_groups.title_group","name":"title_group","parent_path":"users.post_groups","kind":"scalar","data_type":"text","wire":{"encoding":"text"},"nullable":true,"access":"unconditional"},{"path":"users.post_groups.count","name":"count","parent_path":"users.post_groups","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":false,"access":"unconditional"},{"path":"users.post_groups.latest_group","name":"latest_group","parent_path":"users.post_groups","kind":"scalar","data_type":"timestamptz","wire":{"encoding":"timestamptz"},"nullable":false,"access":"unconditional"}]},"params":[],"input":[{"path":"input.users.body.UserStats.params.title","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":true,"nullable":false}],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"users","fragment":"UserStats"}],"source_map":[{"id":"NestedStats","file":"queries/frontend/aggregates.dsql","range":{"start":625,"end":693}}]}
