FlattenRoot
{"name":"FlattenRoot","kind":"query","sql":{"dialect":"postgres","text":"select\n  TO_JSON(CAST(COUNT(*) as text)) as \"user_count\",\n  TO_JSON(MIN(\"users_99fc7350\".\"name\")) as \"first_name\"\nfrom\n  \"public\".\"users\" as \"users_99fc7350\"\nwhere\n  \"users_99fc7350\".\"name\" = ($1)","compact_text":"SELECT TO_JSON(CAST(COUNT(*) AS text)) AS \"user_count\", TO_JSON(MIN(\"users_99fc7350\".\"name\")) AS \"first_name\" FROM \"public\".\"users\" AS \"users_99fc7350\" WHERE \"users_99fc7350\".\"name\" = ($1)","parameters":[{"path":"params.flat_name"}],"variants":[]},"result":{"fields":[{"path":"user_count","name":"user_count","parent_path":"","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":false,"access":"unconditional"},{"path":"first_name","name":"first_name","parent_path":"","kind":"scalar","data_type":"text","wire":{"encoding":"text"},"nullable":true,"access":"unconditional"}]},"params":[{"path":"params.flat_name","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"FlattenRoot","file":"queries/frontend/aggregates.dsql","range":{"start":694,"end":820}}]}
