FlattenOwner
{"name":"FlattenOwner","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"feed_ed7b7225\".\"id\",\n        'owner_name',\n        \"users_json_df293de7\".\"owner_name\",\n        'owner_posts',\n        \"users_json_df293de7\".\"owner_posts\",\n        'owner_post_count',\n        \"users_json_df293de7\".\"owner_post_count\"\n      )\n    ),\n    '[]'\n  ) as \"feed\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"posts\" as \"feed_ed7b7225\"\n    limit\n      1\n  ) as \"feed_ed7b7225\"\n  left join LATERAL (\n    select\n      \"users_df293de7\".\"name\" as \"owner_name\",\n      \"owner_posts_json_cde7a0d1\".\"owner_posts_result_cde7a0d1\" as \"owner_posts\",\n      \"posts_json_0cd127c5\".\"owner_post_count\" as \"owner_post_count\"\n    from\n      \"public\".\"users\" as \"users_df293de7\"\n      left join LATERAL (\n        select\n          COALESCE(\n            JSON_AGG(\n              JSON_BUILD_OBJECT('title', \"owner_posts_cde7a0d1\".\"title\")\n            ),\n            '[]'\n          ) as \"owner_posts_result_cde7a0d1\"\n        from\n          (\n            select\n              *\n            from\n              \"public\".\"posts\" as \"owner_posts_cde7a0d1\"\n            where\n              \"owner_posts_cde7a0d1\".\"user_id\" = \"users_df293de7\".\"id\"\n            limit\n              1\n          ) as \"owner_posts_cde7a0d1\"\n      ) as \"owner_posts_json_cde7a0d1\" on true\n      left join LATERAL (\n        select\n          COUNT(*) as \"owner_post_count\"\n        from\n          \"public\".\"posts\" as \"posts_0cd127c5\"\n        where\n          \"posts_0cd127c5\".\"user_id\" = \"users_df293de7\".\"id\"\n      ) as \"posts_json_0cd127c5\" on true\n    where\n      \"users_df293de7\".\"id\" = \"feed_ed7b7225\".\"user_id\"\n      and \"users_df293de7\".\"name\" = ($1)\n  ) as \"users_json_df293de7\" on true","parameters":[{"path":"params.owner_name"}],"variants":[]},"result":{"fields":[{"path":"feed","name":"feed","parent_path":"","kind":"array","data_type":"object","nullable":false},{"path":"feed.id","name":"id","parent_path":"feed","kind":"scalar","data_type":"uuid","nullable":false},{"path":"feed.owner_name","name":"owner_name","parent_path":"feed","kind":"scalar","data_type":"text","nullable":true},{"path":"feed.owner_posts","name":"owner_posts","parent_path":"feed","kind":"array","data_type":"object","nullable":true},{"path":"feed.owner_posts.title","name":"title","parent_path":"feed.owner_posts","kind":"scalar","data_type":"text","nullable":true},{"path":"feed.owner_post_count","name":"owner_post_count","parent_path":"feed","kind":"scalar","data_type":"int","nullable":true}]},"params":[{"path":"params.owner_name","data_type":"text","enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"FlattenOwner","file":"queries/frontend/aggregates.dsql","range":{"start":906,"end":1136}}]}
