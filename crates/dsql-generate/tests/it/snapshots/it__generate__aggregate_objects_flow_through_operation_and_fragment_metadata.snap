FlattenOwner
{"name":"FlattenOwner","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"feed\" as \"feed\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"feed_ed7b7225\".\"id\",\n        'owner_name',\n        \"users_json_df293de7\".\"owner_name\",\n        'owner_posts',\n        \"users_json_df293de7\".\"owner_posts\",\n        'owner_post_count',\n        \"users_json_df293de7\".\"owner_post_count\"\n      ) as \"feed\"\n    from\n      \"public\".\"posts\" as \"feed_ed7b7225\"\n      left join LATERAL (\n        select\n          \"users_df293de7\".\"name\" as \"owner_name\",\n          \"owner_posts_json_cde7a0d1\".\"owner_posts_result_cde7a0d1\" as \"owner_posts\",\n          \"posts_json_0cd127c5\".\"owner_post_count\" as \"owner_post_count\"\n        from\n          \"public\".\"users\" as \"users_df293de7\"\n          left join LATERAL (\n            select\n              JSON_BUILD_OBJECT('title', \"owner_posts_cde7a0d1\".\"title\") as \"owner_posts_result_cde7a0d1\"\n            from\n              \"public\".\"posts\" as \"owner_posts_cde7a0d1\"\n            where\n              \"owner_posts_cde7a0d1\".\"user_id\" = \"users_df293de7\".\"id\"\n            limit\n              1\n          ) as \"owner_posts_json_cde7a0d1\" on true\n          left join LATERAL (\n            select\n              CAST(COUNT(*) as text) as \"owner_post_count\"\n            from\n              \"public\".\"posts\" as \"posts_0cd127c5\"\n            where\n              \"posts_0cd127c5\".\"user_id\" = \"users_df293de7\".\"id\"\n          ) as \"posts_json_0cd127c5\" on true\n        where\n          \"users_df293de7\".\"id\" = \"feed_ed7b7225\".\"user_id\"\n          and \"users_df293de7\".\"name\" = ($1)\n      ) as \"users_json_df293de7\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"feed\" AS \"feed\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"feed_ed7b7225\".\"id\", 'owner_name', \"users_json_df293de7\".\"owner_name\", 'owner_posts', \"users_json_df293de7\".\"owner_posts\", 'owner_post_count', \"users_json_df293de7\".\"owner_post_count\") AS \"feed\" FROM \"public\".\"posts\" AS \"feed_ed7b7225\" LEFT JOIN LATERAL (SELECT \"users_df293de7\".\"name\" AS \"owner_name\", \"owner_posts_json_cde7a0d1\".\"owner_posts_result_cde7a0d1\" AS \"owner_posts\", \"posts_json_0cd127c5\".\"owner_post_count\" AS \"owner_post_count\" FROM \"public\".\"users\" AS \"users_df293de7\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('title', \"owner_posts_cde7a0d1\".\"title\") AS \"owner_posts_result_cde7a0d1\" FROM \"public\".\"posts\" AS \"owner_posts_cde7a0d1\" WHERE \"owner_posts_cde7a0d1\".\"user_id\" = \"users_df293de7\".\"id\" LIMIT 1) AS \"owner_posts_json_cde7a0d1\" ON true LEFT JOIN LATERAL (SELECT CAST(COUNT(*) AS text) AS \"owner_post_count\" FROM \"public\".\"posts\" AS \"posts_0cd127c5\" WHERE \"posts_0cd127c5\".\"user_id\" = \"users_df293de7\".\"id\") AS \"posts_json_0cd127c5\" ON true WHERE \"users_df293de7\".\"id\" = \"feed_ed7b7225\".\"user_id\" AND \"users_df293de7\".\"name\" = ($1)) AS \"users_json_df293de7\" ON true LIMIT 1) AS \"root\" ON true","parameters":[{"path":"params.owner_name"}],"variants":[]},"result":{"fields":[{"path":"feed","name":"feed","parent_path":"","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":true,"access":"unconditional"},{"path":"feed.id","name":"id","parent_path":"feed","kind":"scalar","data_type":"uuid","wire":{"encoding":"uuid"},"nullable":false,"access":"unconditional"},{"path":"feed.owner_name","name":"owner_name","parent_path":"feed","kind":"scalar","data_type":"text","wire":{"encoding":"text"},"nullable":true,"access":"unconditional"},{"path":"feed.owner_posts","name":"owner_posts","parent_path":"feed","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":true,"access":"unconditional"},{"path":"feed.owner_posts.title","name":"title","parent_path":"feed.owner_posts","kind":"scalar","data_type":"text","wire":{"encoding":"text"},"nullable":true,"access":"unconditional"},{"path":"feed.owner_post_count","name":"owner_post_count","parent_path":"feed","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":true,"access":"unconditional"}]},"params":[{"path":"params.owner_name","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"FlattenOwner","file":"queries/frontend/aggregates.dsql","range":{"start":906,"end":1136}}]}
