{"name":"NestedStats","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"users_99fc7350\".\"id\",\n        'post_stats',\n        \"post_stats_json_f1ab13d3\".\"post_stats_result_f1ab13d3\"\n      )\n    ),\n    '[]'\n  ) as \"users\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"users\" as \"users_99fc7350\"\n    limit\n      1\n  ) as \"users_99fc7350\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'count',\n        COUNT(*),\n        'latest',\n        MAX(\"post_stats_f1ab13d3\".\"created_at\")\n      ) as \"post_stats_result_f1ab13d3\"\n    from\n      \"public\".\"posts\" as \"post_stats_f1ab13d3\"\n    where\n      \"post_stats_f1ab13d3\".\"user_id\" = \"users_99fc7350\".\"id\"\n      and \"post_stats_f1ab13d3\".\"title\" = ($1)\n  ) as \"post_stats_json_f1ab13d3\" on true","parameters":[{"path":"input.users.body.UserStats.params.title"}],"variants":[]},"result":{"fields":[{"path":"users","name":"users","parent_path":"","kind":"array","data_type":"object","nullable":false},{"path":"users.id","name":"id","parent_path":"users","kind":"scalar","data_type":"uuid","nullable":false},{"path":"users.post_stats","name":"post_stats","parent_path":"users","kind":"object","data_type":"object","nullable":false},{"path":"users.post_stats.count","name":"count","parent_path":"users.post_stats","kind":"scalar","data_type":"int","nullable":false},{"path":"users.post_stats.latest","name":"latest","parent_path":"users.post_stats","kind":"scalar","data_type":"timestamptz","nullable":true}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"users","fragment":"UserStats"}],"source_map":[{"id":"NestedStats","file":"queries/frontend/aggregates.dsql","range":{"start":250,"end":318}}]}
