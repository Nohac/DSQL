FlattenNested
{"name":"FlattenNested","kind":"query","sql":{"dialect":"postgres","text":"select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"accounts_c1b9ad84\".\"id\",\n        'flat_post_count',\n        \"posts_json_cd19cb80\".\"flat_post_count\",\n        'flat_latest',\n        \"posts_json_cd19cb80\".\"flat_latest\"\n      )\n    ),\n    '[]'\n  ) as \"accounts\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"users\" as \"accounts_c1b9ad84\"\n    limit\n      1\n  ) as \"accounts_c1b9ad84\"\n  left join LATERAL (\n    select\n      COUNT(*) as \"flat_post_count\",\n      MAX(\"posts_cd19cb80\".\"created_at\") as \"flat_latest\"\n    from\n      \"public\".\"posts\" as \"posts_cd19cb80\"\n    where\n      \"posts_cd19cb80\".\"user_id\" = \"accounts_c1b9ad84\".\"id\"\n      and \"posts_cd19cb80\".\"title\" = ($1)\n  ) as \"posts_json_cd19cb80\" on true","parameters":[{"path":"input.accounts.body.FlatPostStats.params.flat_title"}],"variants":[]},"result":{"fields":[{"path":"accounts","name":"accounts","parent_path":"","kind":"array","data_type":"object","nullable":false},{"path":"accounts.id","name":"id","parent_path":"accounts","kind":"scalar","data_type":"uuid","nullable":false},{"path":"accounts.flat_post_count","name":"flat_post_count","parent_path":"accounts","kind":"scalar","data_type":"int","nullable":false},{"path":"accounts.flat_latest","name":"flat_latest","parent_path":"accounts","kind":"scalar","data_type":"timestamptz","nullable":true}]},"params":[],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"accounts","fragment":"FlatPostStats"}],"source_map":[{"id":"FlattenNested","file":"queries/frontend/aggregates.dsql","range":{"start":821,"end":905}}]}
