{"name":"RootStats","kind":"query","sql":{"dialect":"postgres","text":"select\n  JSON_BUILD_OBJECT(\n    'count',\n    CAST(COUNT(*) as text),\n    'first_name',\n    MIN(\"user_stats_bde1797f\".\"name\")\n  ) as \"user_stats\"\nfrom\n  \"public\".\"users\" as \"user_stats_bde1797f\"\nwhere\n  \"user_stats_bde1797f\".\"name\" = ($1)","compact_text":"SELECT JSON_BUILD_OBJECT('count', CAST(COUNT(*) AS text), 'first_name', MIN(\"user_stats_bde1797f\".\"name\")) AS \"user_stats\" FROM \"public\".\"users\" AS \"user_stats_bde1797f\" WHERE \"user_stats_bde1797f\".\"name\" = ($1)","parameters":[{"path":"params.name"}],"variants":[]},"result":{"fields":[{"path":"user_stats","name":"user_stats","parent_path":"","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":false,"access":"unconditional"},{"path":"user_stats.count","name":"count","parent_path":"user_stats","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":false,"access":"unconditional"},{"path":"user_stats.first_name","name":"first_name","parent_path":"user_stats","kind":"scalar","data_type":"text","wire":{"encoding":"text"},"nullable":true,"access":"unconditional"}]},"params":[{"path":"params.name","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":true,"nullable":false}],"input":[],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[],"source_map":[{"id":"RootStats","file":"queries/frontend/aggregates.dsql","range":{"start":394,"end":510}}]}
