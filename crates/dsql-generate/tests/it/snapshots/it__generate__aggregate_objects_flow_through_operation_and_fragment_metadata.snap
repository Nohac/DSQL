FlattenNested
{"name":"FlattenNested","kind":"query","sql":{"dialect":"postgres","text":"select\n  \"root\".\"accounts\" as \"accounts\"\nfrom\n  (\n    select\n      1) as \"singleton\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT(\n        'id',\n        \"accounts_c1b9ad84\".\"id\",\n        'flat_post_count',\n        \"posts_json_cd19cb80\".\"flat_post_count\",\n        'flat_latest',\n        \"posts_json_cd19cb80\".\"flat_latest\"\n      ) as \"accounts\"\n    from\n      \"public\".\"users\" as \"accounts_c1b9ad84\"\n      left join LATERAL (\n        select\n          CAST(COUNT(*) as text) as \"flat_post_count\",\n          MAX(\"posts_cd19cb80\".\"created_at\") as \"flat_latest\"\n        from\n          \"public\".\"posts\" as \"posts_cd19cb80\"\n        where\n          \"posts_cd19cb80\".\"user_id\" = \"accounts_c1b9ad84\".\"id\"\n          and \"posts_cd19cb80\".\"title\" = ($1)\n      ) as \"posts_json_cd19cb80\" on true\n    limit\n      1\n  ) as \"root\" on true","compact_text":"SELECT \"root\".\"accounts\" AS \"accounts\" FROM (SELECT 1) AS \"singleton\" LEFT JOIN LATERAL (SELECT JSON_BUILD_OBJECT('id', \"accounts_c1b9ad84\".\"id\", 'flat_post_count', \"posts_json_cd19cb80\".\"flat_post_count\", 'flat_latest', \"posts_json_cd19cb80\".\"flat_latest\") AS \"accounts\" FROM \"public\".\"users\" AS \"accounts_c1b9ad84\" LEFT JOIN LATERAL (SELECT CAST(COUNT(*) AS text) AS \"flat_post_count\", MAX(\"posts_cd19cb80\".\"created_at\") AS \"flat_latest\" FROM \"public\".\"posts\" AS \"posts_cd19cb80\" WHERE \"posts_cd19cb80\".\"user_id\" = \"accounts_c1b9ad84\".\"id\" AND \"posts_cd19cb80\".\"title\" = ($1)) AS \"posts_json_cd19cb80\" ON true LIMIT 1) AS \"root\" ON true","parameters":[{"path":"input.accounts.body.FlatPostStats.params.flat_title"}],"variants":[]},"result":{"fields":[{"path":"accounts","name":"accounts","parent_path":"","kind":"object","data_type":"object","wire":{"encoding":"unsupported"},"nullable":true,"access":"unconditional"},{"path":"accounts.id","name":"id","parent_path":"accounts","kind":"scalar","data_type":"uuid","wire":{"encoding":"uuid"},"nullable":false,"access":"unconditional"},{"path":"accounts.flat_post_count","name":"flat_post_count","parent_path":"accounts","kind":"scalar","data_type":"bigint","wire":{"encoding":"big_integer"},"nullable":false,"access":"unconditional"},{"path":"accounts.flat_latest","name":"flat_latest","parent_path":"accounts","kind":"scalar","data_type":"timestamptz","wire":{"encoding":"timestamptz"},"nullable":true,"access":"unconditional"}]},"params":[],"input":[{"path":"input.accounts.body.FlatPostStats.params.flat_title","data_type":"text","wire":{"encoding":"text"},"enum_values":[],"required":true,"nullable":false}],"context":[],"dynamic_inputs":[],"policies":[],"handoffs":[],"fragment_spreads":[{"path":"accounts","fragment":"FlatPostStats"}],"source_map":[{"id":"FlattenNested","file":"queries/frontend/aggregates.dsql","range":{"start":821,"end":905}}]}
