---
source: crates/dsql-project/tests/it/project.rs
expression: "std::fs::read_to_string(project.root.join(\"dsql.toml\")).expect(\"config written\")"
---
database_url = "<database url>"
default_schema = "public"

# Each entry selects physical paths and the resolver that extracts DSQL.
# Add more scopes (and `imports`) to partition definitions.
[resolution.main]
documents = [{ resolver = "dsql", paths = ["**/*.dsql"] }]
