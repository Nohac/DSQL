  "cases": [
    {
      "name": "omitted inputs use algebraic identities",
      "bindings": { "params": { "tenant": 7 } },
      "expected_sql": "select $1 where TRUE and TRUE order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "nullable inputs use algebraic identities",
      "bindings": {
        "params": { "tenant": 7, "search": null, "order": null }
      },
      "expected_sql": "select $1 where TRUE and TRUE order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "and drops empty children and or keeps active children",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": {
            "and": [{ "name": { "like": "A%" } }, {}],
            "or": [{ "id": { "in": [1, 2] } }]
          },
          "order": [{ "id": "desc_nulls_last" }]
        }
      },
      "expected_sql": "select $1 where (((u.name LIKE $2)) AND ((u.id = ANY($3)))) and (((u2.name LIKE $2)) AND ((u2.id = ANY($3)))) order by u.id DESC NULLS LAST",
      "expected_values": [7, "A%", [1, 2]]
    },
    {
      "name": "or containing only empty predicates is false",
      "bindings": {
        "params": { "tenant": 7, "search": { "or": [{}] } }
      },
      "expected_sql": "select $1 where (FALSE) and (FALSE) order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "empty and and not-empty are absent",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "and": [], "not": {} }
        }
      },
      "expected_sql": "select $1 where TRUE and TRUE order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "not of false is active",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "not": { "or": [] } }
        }
      },
      "expected_sql": "select $1 where (NOT ((FALSE))) and (NOT ((FALSE))) order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "empty membership collections use boolean identities",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "id": { "in": [], "not_in": [] } }
        }
      },
      "expected_sql": "select $1 where (FALSE AND TRUE) and (FALSE AND TRUE) order by NULL::integer",
      "expected_values": [7]
    },
    {
      "name": "is null chooses compiler-owned boolean cases",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "id": { "is_null": true } },
          "order": [{ "id": "asc" }]
        }
      },
      "expected_sql": "select $1 where (u.id IS NULL) and (u2.id IS NULL) order by u.id ASC",
      "expected_values": [7]
    },
    {
      "name": "numeric and timestamp values share validation and positions",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": {
            "amount": { "eq": "1." },
            "recorded_at": { "eq": "2024-02-29T23:59:59Z" }
          }
        }
      },
      "expected_sql": "select $1 where (u.amount = $2 AND u.recorded_at = $3) and (u2.amount = $2 AND u2.recorded_at = $3) order by NULL::integer",
      "expected_values": [7, "1.", "2024-02-29T23:59:59Z"]
    },
    {
      "name": "bigint scalar and collection values retain decimal strings",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": {
            "wide_id": {
              "eq": "9223372036854775807",
              "in": ["-9223372036854775808", "9223372036854775807"]
            }
          }
        }
      },
      "expected_sql": "select $1 where (u.wide_id = $2 AND u.wide_id = ANY($3)) and (u2.wide_id = $2 AND u2.wide_id = ANY($3)) order by NULL::integer",
      "expected_values": [
        7,
        "9223372036854775807",
        ["-9223372036854775808", "9223372036854775807"]
      ]
    },
    {
      "name": "overflowing dynamic bigint is rejected",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": {
            "wide_id": { "eq": "9223372036854775808" }
          }
        }
      },
      "error": "params.search.wide_id.eq"
    },
    {
      "name": "unknown selected field is rejected",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "unknown": { "eq": 1 } }
        }
      },
      "error": "params.search.unknown"
    },
    {
      "name": "unknown operator is rejected",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "id": { "gt": 1 } }
        }
      },
      "error": "params.search.id.gt"
    },
    {
      "name": "null scalar operand is rejected",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": { "id": { "eq": null } }
        }
      },
      "error": "params.search.id.eq"
    },
    {
      "name": "invalid calendar timestamp is rejected",
      "bindings": {
        "params": {
          "tenant": 7,
          "search": {
            "recorded_at": { "eq": "2023-02-29T12:00:00Z" }
          }
        }
      },
      "error": "params.search.recorded_at.eq"
    },
    {
