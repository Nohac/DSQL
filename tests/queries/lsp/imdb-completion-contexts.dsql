/*^document_root*/
fragment MoviesInfo /*^fragment_on*/ on /*^fragment_type*/ movie_info {
  id
  title {
    title
  }
}

query CompletionContexts {
  title(/*^clause_keywords*/ where id /*^int_operator*/ > 0 order by /*^order_column*/ id /*^sort_direction*/ asc limit 2) {
    id
    title
  }
  movie_info(where info /*^text_operator*/ == "release dates") {
    id
    info
  }
  movie_info(w/*^clause_prefix*/) {
    id
  }
  movie_info(where /*^where_column*/) {
    id
  }
  movie_info(where id == 1811435 order by /*^order_column_after_where*/) {
    id
  }
  movie_info(where id == 1811435 order by id /*^sort_direction_after_where*/) {
    id
  }
  movie_info(where id == 1811435 order by id asc) {
    id
    movie_id
    note
    note(/*^scalar_clause*/)
    missing_relation(/*^unknown_clause*/)
    /*^movie_info_body_after_clause*/
    .../*^fragment_spread*/
    title(/*^relation_clause_exact_nested*/ {
      /*^title_body_after_clause*/
      id
      cast_info {
        name {
          name
        }
      }
    }
    info_type {
      info
      id
    }
  }
}
