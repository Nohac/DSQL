query RecentReadings {
  readings(
    where .id in $$ids
    order by flagged asc, id $$direction
    limit 10
  ) {
    ...ReadingRow
  }
}

query TypedReading {
  readings(
    where .network_code == $$network
      and .recorded_at >= $$since
      and .value >= $$minimum
      and .confidence >= $$confidence
      and .flagged == $$flagged
      and .payload == $$payload
    limit 1
  ) {
    id
  }
}

query NetworkTopology {
  networks(where .stations | exists order by code asc) {
    code
    name
    stations(order by code asc) {
      code
      name
      metadata
      sensors(order by code asc) {
        ...SensorIdentity
      }
    }
  }
}

query PrivacyProbe {
  readings(
    where .confidence == $$confidence
      or .confidence is null
      or .confidence in $$confidences
    limit 1
  ) {
    id
  }
}

query ManualFilterProbe {
  readings(filter FlaggedOnly when $$onlyFlagged order by id asc limit 1) {
    id
    flagged
  }
}

query EmptyAggregateCount {
  sensors(where .code == "humidity" and (.readings | count) == 0 limit 1) {
    code
  }
}

query EmptyAggregateMinimum {
  sensors(
    where .code == "humidity" and (.readings | min .recorded_at) != $$never
    limit 1
  ) {
    code
  }
}

query MissingFlattened {
  ...readings(where .id < 0 limit 1) {
    missing_id: id
  }
}
