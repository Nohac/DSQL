filter TenantScope on {
  .tenant_id: uuid
} {
  apply where true
  where .tenant_id == $:tenant_id
}

filter ReadingPrivacy on readings {
  apply where true
  field payload, confidence where $:can_read_payload
}

filter FlaggedOnly on readings {
  where .flagged == true
}

fragment ReadingRow on readings {
  id
  network_code
  station_code
  sensor_code
  recorded_at
  value
  confidence
  flagged
  payload
}

fragment SensorIdentity on sensors {
  code
  unit
}

fragment SensorReadingWindow(
  $recorded_after? = null
  $$reading_limit? = 2
  $$reading_direction = "desc"
) on sensors {
  readings(where .recorded_at >= $recorded_after
    order by recorded_at $$reading_direction, id desc
    limit $$reading_limit
  ) {
    ...ReadingRow
  }
}
