{
  "name": "MovieInfoLookup",
  "kind": "query",
  "sql": {
    "dialect": "postgres",
    "text": "select\n  COALESCE(\n    JSON_AGG(\n      JSON_BUILD_OBJECT(\n        'id',\n        \"movie_info_d37aaa02\".\"id\",\n        'info',\n        \"movie_info_d37aaa02\".\"info\",\n        'note',\n        \"movie_info_d37aaa02\".\"note\",\n        'title',\n        \"title_json_85df456e\".\"title_result_85df456e\",\n        'info_type',\n        \"info_type_json_3587486e\".\"info_type_result_3587486e\"\n      )\n    ),\n    '[]'\n  ) as \"movie_info_result_d37aaa02\"\nfrom\n  (\n    select\n      *\n    from\n      \"public\".\"movie_info\" as \"movie_info_d37aaa02\"\n    where\n      \"movie_info_d37aaa02\".\"id\" > 0\n    order by\n      \"movie_info_d37aaa02\".\"id\" asc\n    limit\n      2\n  ) as \"movie_info_d37aaa02\"\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT('title', \"title_85df456e\".\"title\") as \"title_result_85df456e\"\n    from\n      \"public\".\"title\" as \"title_85df456e\"\n    where\n      \"title_85df456e\".\"id\" = \"movie_info_d37aaa02\".\"movie_id\"\n      and \"title_85df456e\".\"episode_nr\" = 100\n  ) as \"title_json_85df456e\" on true\n  left join LATERAL (\n    select\n      JSON_BUILD_OBJECT('info', \"info_type_3587486e\".\"info\") as \"info_type_result_3587486e\"\n    from\n      \"public\".\"info_type\" as \"info_type_3587486e\"\n    where\n      \"info_type_3587486e\".\"id\" = \"movie_info_d37aaa02\".\"info_type_id\"\n  ) as \"info_type_json_3587486e\" on true",
    "parameters": [],
    "variants": []
  },
