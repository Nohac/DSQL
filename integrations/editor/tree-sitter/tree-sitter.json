{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dsql",
      "camelcase": "DSQL",
      "title": "DSQL",
      "scope": "source.dsql",
      "file-types": ["dsql"],
      "injection-regex": "^dsql$",
      "class-name": "TreeSitterDsql",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for DSQL"
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
