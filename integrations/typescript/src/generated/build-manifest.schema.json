{
  "$id": "https://dsql.dev/schemas/build-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "path",
          "hash",
          "source"
        ],
        "additionalProperties": false,
        "title": "FragmentManifestEntry"
      }
    },
    "generationId": {
      "type": "integer",
      "minimum": 0,
      "description": "The project-monotonic generation this manifest commits\n (docs/spec/build-daemon.md). Required in version 2; version-1\n pointers are read through a private compatibility reader."
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "path",
          "hash",
          "source"
        ],
        "additionalProperties": false,
        "title": "OperationManifestEntry"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "generationId",
    "operations",
    "fragments"
  ],
  "additionalProperties": false,
  "title": "BuildManifest"
}
