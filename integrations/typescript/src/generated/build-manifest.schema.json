{
  "$id": "https://dsql.dev/schemas/build-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operations": {
      "items": {
        "properties": {
          "hash": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "path",
          "hash",
          "source"
        ],
        "type": "object"
      },
