{
  "name": "@dsql/typescript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "bun": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "bun": {
        "types": "./src/node.ts",
        "default": "./src/node.ts"
      },
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./vite": {
      "bun": {
        "types": "./src/vite.ts",
        "default": "./src/vite.ts"
      },
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "renderers",
    "templates"
  ],
  "scripts": {
    "generate": "cargo run -q --manifest-path ../../Cargo.toml -p dsql-cli -- generate --target typescript-metadata --out-dir src/generated",
    "generate:project": "bun renderers/basic.ts",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p tsconfig.renderers.json",
    "build": "bunx tsc"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-morph": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
